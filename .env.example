# ==============================================================================
# NEURA ENVIRONMENT CONFIGURATION (PHASE 1.8: SUPABASE AUTH & SSR)
# ==============================================================================
# IMPORTANT SECURITY GUIDANCE:
# 1. Never commit .env, .env.local, or actual secret keys to version control.
# 2. Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JavaScript.
#    NEVER expose service-role keys or database passwords with NEXT_PUBLIC_.
# ==============================================================================

# Application Base URL (Used for auth redirects and email callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE AUTHENTICATION & SSR CONFIGURATION
# ------------------------------------------------------------------------------
# Find these values in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# ------------------------------------------------------------------------------
# DEVELOPMENT / MOCK PROTOTYPE MODE
# ------------------------------------------------------------------------------
# When Supabase credentials above are not yet provided:
# - Set to 'true' in local development to test the UI with prototype mock accounts.
# - In production, this is automatically disabled unless explicitly set to 'true'.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true

# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (Optional, Server Actions / Migrations only - NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-prefix-with-next-public

# ------------------------------------------------------------------------------
# OPENROUTER AI (PHASE 4: EDUCATIONAL NOTES & MCQ GENERATION - SERVER-ONLY)
# ------------------------------------------------------------------------------
# Get a free API key at https://openrouter.ai/keys
# DO NOT prefix with NEXT_PUBLIC_. This must NEVER be exposed to the browser.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Model to use for planning, notes, and MCQ generation.
# Free models (no billing): meta-llama/llama-3.3-8b-instruct:free
# Other models: see https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free

# ------------------------------------------------------------------------------
# HUGGING FACE INFERENCE API (PHASE 2 & 3: AI ENGINE & VIDEO PIPELINE - SERVER-ONLY)
# ------------------------------------------------------------------------------
# Create a User Access Token with inference permissions at https://huggingface.co/settings/tokens
# DO NOT prefix with NEXT_PUBLIC_. This must NEVER be exposed to the browser.
HF_TOKEN=your-huggingface-token-here
HUGGING_FACE_HUB_TOKEN=your-huggingface-token-here

# Text Planning Model (Hugging Face Inference Router)
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Text-to-Video Generation Model (Hugging Face Inference)
# Supported options: Lightricks/LTX-2.5 | Lightricks/ltx-video-distilled | Lightricks/LTX-2.5-Diffusers | Wan-AI/Wan2.1-T2V-1.3B | tencent/HunyuanVideo
HF_VIDEO_MODEL=Lightricks/LTX-2.5

# Video Inference Provider (fal-ai | replicate | hf-inference)
HF_VIDEO_PROVIDER=fal-ai

# ------------------------------------------------------------------------------
# PIXAZO API (PHASE 3.1: LTX 2.5 LITE VIDEO GENERATION - SERVER-ONLY)
# ------------------------------------------------------------------------------
# Get your Pixazo API subscription key from https://pixazo.ai
# Passed via 'Ocp-Apim-Subscription-Key' header. NEVER expose to the browser.
PIXAZO_API_KEY=your-pixazo-api-key-here
PIXAZO_LTX_MODEL=ltx-2-5-lite
PIXAZO_GATEWAY_URL=https://gateway.pixazo.ai

# Active Video Provider selection (pixazo | huggingface)
VIDEO_PROVIDER=pixazo
